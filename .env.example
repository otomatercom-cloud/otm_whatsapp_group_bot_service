# Copy to .env and fill in before starting the service.

# Port this service listens on.
PORT=8721

# Shared secret Odoo must send as "Authorization: Bearer <API_TOKEN>" on
# every request. Generate one with: openssl rand -hex 32
API_TOKEN=change-me-to-a-real-random-secret

# Where Baileys persists the paired WhatsApp session (multi-file auth
# state) so the service doesn't need a QR re-scan on every restart.
# Keep this directory backed up and NEVER commit it to git - anyone with
# these files can act as the paired WhatsApp number.
AUTH_STATE_DIR=./auth_info

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
